# Socrata Open Data API token
# Optional but raises rate limit from 1 000 to 10 000 requests/hour.
# Register at https://opendata.miamidade.gov/signup
SODA_APP_TOKEN=

# How many days back to pull on each ingest run (default: 30)
INGEST_SINCE_DAYS=30

# Per-source HTTP timeout in milliseconds (default: 30000)
INGEST_TIMEOUT_MS=30000
